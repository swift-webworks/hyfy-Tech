# =============================================================================
# HY-FY Technology - Environment Variables (DEMO FILE)
#
# Copy this file to ".env" and fill in real values for your environment.
# NEVER commit the real ".env" file to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# Core Django settings
# ---------------------------------------------------------------------------
# Generate a real one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-value

# True only for local development. Must be False in production.
DJANGO_DEBUG=True

# Comma-separated list of domains/IPs allowed to serve this site.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,hyfytechnology.com,www.hyfytechnology.com

# Comma-separated list of trusted origins for CSRF (must include scheme).
DJANGO_CSRF_TRUSTED_ORIGINS=https://hyfytechnology.com,https://www.hyfytechnology.com

# Public URL used to build canonical/OG links and the sitemap.
SITE_URL=https://hyfytechnology.com

# Rename the Django Admin URL in production so it isn't left at the
# predictable /admin/ path. Include the trailing slash.
DJANGO_ADMIN_URL=admin/

# ---------------------------------------------------------------------------
# Security toggles
# Leave unset to auto-derive from DJANGO_DEBUG (recommended). Override only
# if you need to test HTTPS behaviour locally or run behind a TLS-terminating
# proxy that already handles these headers.
# ---------------------------------------------------------------------------
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# Database
# Development default (used automatically if unset): SQLite3
# Production (PostgreSQL, recommended):
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///db.sqlite3

# ---------------------------------------------------------------------------
# Email (Resend - https://resend.com)
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
ENQUIRY_FROM_EMAIL=enquiries@hyfytechnology.com
ENQUIRY_TO_EMAIL=hyfy.technology@hotmail.com

# ---------------------------------------------------------------------------
# Company contact details (used across templates & footer)
# ---------------------------------------------------------------------------
COMPANY_PHONE=9750641426
COMPANY_EMAIL=hyfy.technology@hotmail.com
COMPANY_ADDRESS=New No. 30, Old No. 795, 1st Floor, Trunk Road, Poonamallee, Chennai, Tamil Nadu - 600056
WHATSAPP_NUMBER=919750641426

# ---------------------------------------------------------------------------
# Third-party integrations (optional - leave blank to disable)
# ---------------------------------------------------------------------------
GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=REPLACE_WITH_REAL_EMBED_SRC
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
